{
	"name": "aws-samples/sample-ai-chat-for-amazon-bedrock-wordpress",
	"description": "Development tooling for the AI Chat for Amazon Bedrock sample WordPress plugin. The plugin itself has no runtime dependencies.",
	"license": "MIT-0",
	"type": "project",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "9.6.38",
		"squizlabs/php_codesniffer": "3.13.6",
		"wp-coding-standards/wpcs": "3.4.1",
		"phpcompatibility/phpcompatibility-wp": "2.1.8",
		"dealerdirect/phpcodesniffer-composer-installer": "v1.2.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform-check": false
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs"
	}
}
